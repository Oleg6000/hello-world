<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Full-screen visualizer canvas -->
    <com.musicvisualizer.MusicVisualizerView
        android:id="@+id/visualizerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Track info pill at the top -->
    <TextView
        android:id="@+id/trackInfoText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="48dp"
        android:paddingHorizontal="16dp"
        android:paddingVertical="6dp"
        android:background="@drawable/track_info_bg"
        android:textColor="@android:color/white"
        android:textSize="13sp"
        android:maxLines="1"
        android:ellipsize="end"
        android:text="" />

    <!-- Close button -->
    <ImageButton
        android:id="@+id/btnClose"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="48dp"
        android:layout_marginEnd="16dp"
        android:src="@android:drawable/ic_menu_close_clear_cancel"
        android:background="@drawable/close_button_bg"
        android:padding="8dp"
        android:contentDescription="Close visualizer" />

</FrameLayout>
